# Formspree form ID for the contact form
# Sign up at https://formspree.io, create a form, copy the ID from the form URL
# (https://formspree.io/f/<ID>) and paste it here. Then duplicate this file as
# .env.local so Next.js picks it up at build/dev time.
NEXT_PUBLIC_FORMSPREE_ID=

# Public site URL — used for metadataBase, canonical, OG/sitemap absolute URLs.
# Set this to the production domain at deploy time (e.g. https://www.arthurreynet.dev
# or the Vercel URL). Defaults to https://www.arthurreynet.dev if unset.
NEXT_PUBLIC_SITE_URL=
